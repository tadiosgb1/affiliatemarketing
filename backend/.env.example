# Backend runtime
NODE_ENV=development
PORT=5000

# Comma-separated browser origins allowed by CORS.
# Vite runs on port 5173 by default (see frontend/vite.config.js).
CORS_ORIGIN=http://localhost:5173

# MySQL connection (must match a database created locally)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=affiliate_market
DB_USER=root
DB_PASSWORD=

# Authentication
# Replace this placeholder with a long, random, private secret before running.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
